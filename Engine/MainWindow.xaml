<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audion Windows Tools by Max.mov"
        Height="900" Width="1600"
        MinHeight="800" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#16161a"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">

  <!-- ════════════════ PALETTE + STYLES ════════════════ -->
  <Window.Resources>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBg"          Color="#16161a"/>
    <SolidColorBrush x:Key="WindowSurface"  Color="#1c1c20"/>
    <SolidColorBrush x:Key="SidebarSurface" Color="#19191d"/>
    <SolidColorBrush x:Key="TitlebarBg"     Color="#0c0c14"/>
    <SolidColorBrush x:Key="CardNeutral"    Color="#232329"/>

    <!-- Selection surface (cyan) -->
    <SolidColorBrush x:Key="CyanFill"       Color="#1b2a2e"/>
    <SolidColorBrush x:Key="CyanBorder"     Color="#28515a"/>
    <SolidColorBrush x:Key="CyanHeader"     Color="#28515a"/>

    <!-- Official / applied (green) -->
    <SolidColorBrush x:Key="GreenAccent"    Color="#2e9fb3"/>
    <SolidColorBrush x:Key="GreenDeep"      Color="#176675"/>

    <!-- Unofficial / risk (amber) -->
    <SolidColorBrush x:Key="AmberAccent"    Color="#c75b31"/>
    <SolidColorBrush x:Key="AmberBright"    Color="#e97843"/>
    <SolidColorBrush x:Key="AmberDeep"      Color="#742d1c"/>
    <SolidColorBrush x:Key="AmberCardBg"    Color="#30211d"/>
    <SolidColorBrush x:Key="AmberPillBg"    Color="#421f14"/>

    <!-- Direct action / alternative path (sand) -->
    <SolidColorBrush x:Key="SandAccent"     Color="#b8874b"/>
    <SolidColorBrush x:Key="SandBright"     Color="#d6ad70"/>
    <SolidColorBrush x:Key="SandDeep"       Color="#634826"/>
    <SolidColorBrush x:Key="SandCardBg"     Color="#2d271f"/>
    <SolidColorBrush x:Key="SandBorder"     Color="#785b39"/>
    <SolidColorBrush x:Key="SandBtnBg"      Color="#3c2e1d"/>
    <SolidColorBrush x:Key="SandBtnText"    Color="#ecd3a4"/>

    <!-- Neutral card badges: deliberately separate from semantic marker colors -->
    <SolidColorBrush x:Key="BadgeBg"         Color="#14301f"/>
    <SolidColorBrush x:Key="BadgeBorder"     Color="#235c3a"/>
    <SolidColorBrush x:Key="BadgeText"       Color="#7cc392"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TitleText"      Color="#e2e2e5"/>
    <SolidColorBrush x:Key="TitleOnCyan"    Color="#d8dcde"/>
    <SolidColorBrush x:Key="DescText"       Color="#82828a"/>
    <SolidColorBrush x:Key="DescMuted"      Color="#8a8a92"/>
    <SolidColorBrush x:Key="SidebarText"    Color="#a8a8af"/>
    <SolidColorBrush x:Key="SidebarMuted"   Color="#82828a"/>
    <SolidColorBrush x:Key="HeaderHint"     Color="#5f5f68"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ToggleOffTrack" Color="#34343c"/>
    <SolidColorBrush x:Key="ToggleOffThumb" Color="#8f8f97"/>
    <SolidColorBrush x:Key="ToggleOnThumb"  Color="#e0faff"/>
    <SolidColorBrush x:Key="ApplyBtnBg"     Color="#123139"/>
    <SolidColorBrush x:Key="ApplyBtnText"   Color="#bfe6eb"/>
    <SolidColorBrush x:Key="ApplyBtnBorder" Color="#1f6270"/>
    <SolidColorBrush x:Key="SecBtnBg"       Color="#242429"/>
    <SolidColorBrush x:Key="SecBtnText"     Color="#b8b8bd"/>

    <!-- Log / terminal panels -->
    <SolidColorBrush x:Key="PanelHeaderBg"      Color="#0e0e18"/>
    <SolidColorBrush x:Key="PanelBodyBg"        Color="#0c0c14"/>
    <SolidColorBrush x:Key="PanelInputBg"       Color="#07070e"/>
    <SolidColorBrush x:Key="PanelBorder"        Color="#16ffffff"/>
    <SolidColorBrush x:Key="PanelLabelText"     Color="#48485a"/>
    <SolidColorBrush x:Key="LogText"            Color="#6868a0"/>
    <SolidColorBrush x:Key="LogTimestampText"   Color="#383852"/>
    <SolidColorBrush x:Key="TerminalText"       Color="#c0c0d4"/>
    <SolidColorBrush x:Key="TerminalInputText"  Color="#e0e0ea"/>
    <SolidColorBrush x:Key="TerminalCommandText" Color="#5ab0d0"/>
    <SolidColorBrush x:Key="TerminalOkText"     Color="#35b0c0"/>
    <SolidColorBrush x:Key="TerminalWarnText"   Color="#c6944f"/>
    <SolidColorBrush x:Key="TerminalErrorText"  Color="#d86436"/>

    <!-- Strip all default Button chrome so PS-generated buttons show correctly -->
    <Style TargetType="Button">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toggle button as a pill switch -->
    <Style TargetType="ToggleButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="38" Height="20"
                    CornerRadius="10"
                    Background="{StaticResource ToggleOffTrack}">
              <Ellipse x:Name="Thumb" Width="16" Height="16"
                       HorizontalAlignment="Left"
                       Margin="2,0,0,0"
                       Fill="{StaticResource ToggleOffThumb}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource GreenDeep}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource ToggleOnThumb}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ScrollBar minimal dark style -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid>
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#40ffffff" Margin="1,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Minimal dark CheckBox for tweak selection -->
    <Style TargetType="CheckBox">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Box" Width="16" Height="16"
                    CornerRadius="3" BorderThickness="1.5"
                    BorderBrush="#40ffffff" Background="Transparent">
              <TextBlock x:Name="Check" Text="&#10003;"
                         FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource GreenAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="Collapsed"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenDeep}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenAccent}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- ════════════════ ROOT LAYOUT ════════════════ -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- title bar -->
      <RowDefinition Height="Auto"/>  <!-- reboot banner (collapsed by default) -->
      <RowDefinition Height="*"/>     <!-- body -->
    </Grid.RowDefinitions>

    <!-- ── Title bar ── -->
    <Border Grid.Row="0" Background="{StaticResource TitlebarBg}" Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Audion Windows Tools by Max.mov" Foreground="#ededef" FontWeight="Medium"
                     VerticalAlignment="Center"/>
          <TextBlock Text="— интерактивный компаньон" Foreground="#6a6a73"
                     Margin="8,0,0,0" VerticalAlignment="Center"/>
          <Border x:Name="AdminBadge" CornerRadius="4" BorderThickness="0.5"
                  BorderBrush="{StaticResource GreenDeep}"
                  Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="admin" FontSize="10" Foreground="{StaticResource GreenAccent}"/>
          </Border>
          <Border x:Name="PwshBadge" CornerRadius="4" BorderThickness="0.5"
                  BorderBrush="{StaticResource AmberAccent}"
                  Background="{StaticResource AmberPillBg}"
                  Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                  Visibility="Collapsed">
            <TextBlock x:Name="PwshBadgeText" Text="PowerShell 7 missing" FontSize="10"
                       Foreground="{StaticResource AmberBright}"/>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ThemeBtn"
                  BorderThickness="0.5" BorderBrush="#28ffffff"
                  Background="Transparent" Padding="10,4" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ThemeBtnText" Text="Graphite" FontSize="11"
                         Foreground="{StaticResource SidebarMuted}"/>
              <TextBlock Text="  &#x25BE;" FontSize="11"
                         Foreground="{StaticResource SidebarMuted}"/>
            </StackPanel>
          </Button>
          <Button x:Name="LangBtn"
                  BorderThickness="0.5" BorderBrush="#28ffffff"
                  Background="Transparent" Padding="10,4">
            <TextBlock x:Name="LangBtnText" Text="RU" FontSize="11"
                       Foreground="{StaticResource SidebarMuted}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Reboot banner (shown after any RequiresReboot tweak) ── -->
    <Border Grid.Row="1" x:Name="RebootBanner" Visibility="Collapsed"
            Background="{StaticResource SandCardBg}" BorderBrush="{StaticResource SandAccent}" BorderThickness="0,0,0,1"
            Padding="14,7">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#9888; " Foreground="{StaticResource SandBright}" FontSize="13" VerticalAlignment="Center"/>
        <TextBlock x:Name="RebootText" Text="Restart required for applied changes."
                   Foreground="{StaticResource SandBright}" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ── Body: sidebar (full height) | right area ── -->
    <Grid Grid.Row="2" Background="{StaticResource WindowSurface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── Sidebar — full height, never clipped by terminal/log ── -->
      <Border Grid.Column="0"
              Background="{StaticResource SidebarSurface}"
              BorderBrush="#12ffffff" BorderThickness="0,0,0.5,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SectionTree" Margin="0,8,0,12"/>
        </ScrollViewer>
      </Border>

      <!-- ── Right area: rows = [content+log] / [term-grip] / [terminal] ── -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition x:Name="TerminalSplitterRow" Height="0" MinHeight="0"/>
          <RowDefinition x:Name="TerminalRow"         Height="0" MinHeight="0"/>
        </Grid.RowDefinitions>

        <!-- ── Content + Log row: cols = [main] / [log-grip] / [log] ── -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="LogSplitterCol" Width="0" MinWidth="0"/>
            <ColumnDefinition x:Name="LogCol"         Width="0" MinWidth="0"/>
          </Grid.ColumnDefinitions>

          <!-- Main content (header / cards / footer) -->
          <Grid Grid.Column="0" Margin="10,10,10,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Subsection header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock x:Name="PanelTitle"
                           Text="Select a section"
                           Foreground="White" FontSize="15" FontWeight="Medium"/>
                <TextBlock x:Name="PanelStats"
                           Text=""
                           Foreground="{StaticResource DescText}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>

            <!-- Cards -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="CardStack" Margin="0,0,4,0"/>
            </ScrollViewer>

            <!-- Footer: left = action buttons   right = panel toggles -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- ── Progress strip (visible only during Apply / Revert) ── -->
              <Border Grid.Row="0" x:Name="ProgressStrip" Visibility="Collapsed" Margin="0,0,0,5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="ProgressStatusText"
                               Foreground="{StaticResource DescText}" FontSize="11"
                               Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="OpProgressBar"
                                 Height="5" Minimum="0" Maximum="100" Value="0"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource GreenAccent}"
                                 Background="#18182a" BorderThickness="0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ProgressCountText"
                               Text=""
                               Foreground="{StaticResource DescMuted}" FontSize="11"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ProgressElapsedText"
                               Text=""
                               Foreground="{StaticResource DescMuted}" FontSize="10"
                               Opacity="0.7" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" x:Name="BtnCancelOp" Content="Cancel"
                          Margin="14,0,0,0" Padding="10,3,10,3" FontSize="11"
                          VerticalAlignment="Center" Cursor="Hand"
                          Background="{StaticResource SecBtnBg}"
                          Foreground="{StaticResource SecBtnText}"
                          BorderThickness="0"/>
                </Grid>
              </Border>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">

                  <Button x:Name="BtnApply"
                          Background="{StaticResource ApplyBtnBg}"
                          BorderBrush="{StaticResource ApplyBtnBorder}"
                          Foreground="{StaticResource ApplyBtnText}"
                          Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#9654; " Foreground="{StaticResource GreenAccent}" FontSize="11"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="BtnApplyLabel" Text="Apply section" FontWeight="Medium"/>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnRevert"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="{StaticResource AmberAccent}"
                          Foreground="{StaticResource SecBtnText}"
                          Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#8635; " Foreground="{StaticResource AmberAccent}" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="BtnRevertLabel" Text="Revert"/>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnRefresh"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="#14ffffff"
                          Foreground="{StaticResource SecBtnText}"
                          Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#10227; " Foreground="{StaticResource SecBtnText}" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="BtnRefreshLabel" Text="Refresh status"/>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnCleanApp"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="#14ffffff"
                          Foreground="{StaticResource SecBtnText}"
                          Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#10006; " Foreground="{StaticResource DescMuted}" FontSize="11"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="BtnCleanAppLabel" Text="Clear data"/>
                    </StackPanel>
                  </Button>

                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6,0,0,0">
                  <Button x:Name="BtnDocs"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="#14ffffff"
                          Foreground="{StaticResource SecBtnText}"
                          Width="52" Height="30" Padding="0" Margin="0,0,6,0"
                          ToolTip="Open all documentation">
                    <TextBlock x:Name="BtnDocsLabel" Text="ДОКИ" FontSize="9" FontWeight="Medium"
                               Foreground="{StaticResource SecBtnText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>

                  <Button x:Name="BtnInstallPwsh"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="#14ffffff"
                          Foreground="{StaticResource SecBtnText}"
                          Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                          ToolTip="Install portable PowerShell 7">
                    <Grid>
                      <TextBlock Text="&#8595;" Foreground="{StaticResource GreenAccent}" FontSize="14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock x:Name="BtnInstallPwshLabel" Text="Install PowerShell" Visibility="Collapsed"/>
                    </Grid>
                  </Button>

                  <Border Width="1" Height="22" Background="#18ffffff"
                          Margin="0,4,6,0"/>

                  <Button x:Name="BtnToggleLog"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="#14ffffff"
                          Foreground="{StaticResource SecBtnText}"
                          Padding="10,5" Margin="0,0,4,0"
                          ToolTip="Toggle log panel">
                    <TextBlock x:Name="BtnToggleLogLabel" Text="Log &#9654;" FontSize="11"/>
                  </Button>
                  <Button x:Name="BtnToggleTerminal"
                          Background="{StaticResource SecBtnBg}"
                          BorderBrush="#14ffffff"
                          Foreground="{StaticResource SecBtnText}"
                          Padding="10,5" Margin="0,0,0,0"
                          ToolTip="Toggle terminal panel">
                    <TextBlock x:Name="BtnToggleTerminalLabel" Text="Terminal &#9660;" FontSize="11"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>

          <!-- Log splitter grip (shown only when log is open) -->
          <GridSplitter Grid.Column="1" x:Name="LogSplitter"
                        Width="4" HorizontalAlignment="Stretch"
                        Background="#1cffffff" Visibility="Collapsed"
                        ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

          <!-- ── Log panel ── -->
          <Grid Grid.Column="2" x:Name="LogPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,0.5"
                    Padding="10,5">
              <Grid>
                <TextBlock Text="LOG" Foreground="{StaticResource PanelLabelText}" FontSize="10" FontWeight="Medium"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnCollapseLog"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Padding="6,2"
                        ToolTip="Close log">
                  <TextBlock Text="✕" Foreground="{StaticResource PanelLabelText}" FontSize="10"/>
                </Button>
              </Grid>
            </Border>

            <RichTextBox Grid.Row="1" x:Name="LogBox"
                         Background="{StaticResource PanelBodyBg}" BorderThickness="0"
                         IsReadOnly="True"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="11" Padding="8,6"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Foreground="{StaticResource LogText}"/>
          </Grid>
        </Grid>

        <!-- Terminal splitter grip -->
        <GridSplitter Grid.Row="1" x:Name="TerminalSplitter"
                      Height="4" HorizontalAlignment="Stretch"
                      Background="#1cffffff" Visibility="Collapsed"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

        <!-- ── Terminal panel ── -->
        <Grid Grid.Row="2" x:Name="TerminalPanel" Visibility="Collapsed"
              Background="{StaticResource PanelBodyBg}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,0.5"
                  Padding="10,5">
            <Grid>
              <TextBlock Text="TERMINAL" Foreground="{StaticResource PanelLabelText}" FontSize="10" FontWeight="Medium"
                         VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnMaximizeTerminal"
                        Background="Transparent" BorderThickness="0" Padding="6,2"
                        ToolTip="Expand terminal">
                  <TextBlock x:Name="BtnMaximizeTerminalLabel" Text="↕"
                             Foreground="{StaticResource PanelLabelText}" FontSize="11"/>
                </Button>
                <Button x:Name="BtnCollapseTerminal"
                        Background="Transparent" BorderThickness="0" Padding="6,2"
                        ToolTip="Close terminal">
                  <TextBlock Text="✕" Foreground="{StaticResource PanelLabelText}" FontSize="10"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <RichTextBox Grid.Row="1" x:Name="TerminalBox"
                       Background="Transparent" BorderThickness="0"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="12" Padding="10,6"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       Foreground="{StaticResource TerminalText}"/>

          <Border Grid.Row="2" Background="{StaticResource PanelInputBg}"
                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0.5,0,0"
                  Padding="8,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="PS ❯ "
                         Foreground="{StaticResource GreenAccent}"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" x:Name="TerminalInput"
                        Background="Transparent" BorderThickness="0"
                       Foreground="{StaticResource TerminalInputText}" CaretBrush="{StaticResource TerminalInputText}"
                        FontFamily="Cascadia Code, Consolas, Courier New"
                        FontSize="12" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>

      </Grid>
    </Grid>
  </Grid>
</Window>
